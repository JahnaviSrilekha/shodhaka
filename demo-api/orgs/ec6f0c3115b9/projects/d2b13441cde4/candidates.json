[{"ref":"org:acme-architecture","source":"organization","in_effect":true,"id":"acme-architecture","title":"Acme Shop microservice architecture standards","version":"1.0","description":"Engineering rules every Acme Shop service design, configuration and container image must follow. Checked against ADRs, application configuration and Dockerfiles.","rules":[{"id":"ARCH-01","title":"No shared database between services","severity":"high","applies_to":["adr"],"method":"decider","applies_per":"section"},{"id":"ARCH-02","title":"Reliable event publishing","severity":"high","applies_to":["adr"],"method":"decider","applies_per":"section"},{"id":"ARCH-03","title":"No secrets in configuration files","severity":"high","applies_to":["config"],"method":"code","applies_per":null},{"id":"ARCH-04","title":"Correlation ID on every inter-service message","severity":"medium","applies_to":["adr"],"method":"decider","applies_per":"document"},{"id":"ARCH-05","title":"Synchronous calls declare timeouts and a fallback","severity":"medium","applies_to":["adr"],"method":"decider","applies_per":"section"},{"id":"ARCH-06","title":"Health endpoint exposed","severity":"medium","applies_to":["config"],"method":"code","applies_per":null},{"id":"ARCH-07","title":"Pinned container base images","severity":"low","applies_to":["dockerfile"],"method":"code","applies_per":null}]},{"ref":"org:dora","source":"organization","in_effect":true,"id":"dora","title":"DORA ICT risk essentials (EU 2022/2554)","version":"0.1","description":"Digital Operational Resilience Act essentials for financial entities, checked against ICT risk, incident, continuity, testing and third-party policies. A simplified starting point, not legal advice: verify every rule against the regulation and its technical standards before relying on it.","rules":[{"id":"DORA-01","title":"Management body owns ICT risk","severity":"high","applies_to":["adr"],"method":"decider","applies_per":"document"},{"id":"DORA-02","title":"Documented ICT risk m